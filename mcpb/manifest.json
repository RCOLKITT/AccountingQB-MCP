    {"name": "qb_batch_create_journal_entries", "description": "Bulk create journal entries"},
    {"name": "qb_bulk_update_vendor", "description": "Assign vendor to multiple txns"},
    {"name": "qb_bulk_update_vendors_multi", "description": "Bulk vendor assignment"},
    {"name": "qb_account_balance", "description": "Get account balance"},
    {"name": "qb_account_transactions", "description": "All transactions for an account"},
    {"name": "qb_transaction_detail", "description": "Full details of one transaction"},
    {"name": "qb_reconcile_invoices", "description": "Match invoices to transactions"},
    {"name": "qb_match_invoices_to_transactions", "description": "Fuzzy match invoices to QB"},
    {"name": "qb_uncategorized_transactions", "description": "Find uncategorized items"},
    {"name": "qb_find_duplicates", "description": "Detect duplicate transactions"},
    {"name": "qb_auto_categorize_suggestions", "description": "AI categorization suggestions"},
    {"name": "qb_anomaly_detection", "description": "Detect unusual transactions"},
    {"name": "qb_unknown_vendor_report", "description": "Find unknown/missing vendors"},
    {"name": "qb_compare_periods", "description": "Compare two time periods"},
    {"name": "qb_monthly_burn_rate", "description": "Monthly burn rate analysis"},
    {"name": "qb_runway_calculator", "description": "Cash runway calculator"},
    {"name": "qb_cash_flow_forecast", "description": "Project future cash flow"},
    {"name": "qb_profit_margin_analysis", "description": "Margins by customer/item"},
    {"name": "qb_budget_vs_actual", "description": "Budget vs actual spending"},
    {"name": "qb_vendor_summary", "description": "Top vendors by spend"},
    {"name": "qb_schedule_c", "description": "Schedule C line mapping"},
    {"name": "qb_schedule_c_detailed", "description": "Detailed Schedule C with accounts"},
