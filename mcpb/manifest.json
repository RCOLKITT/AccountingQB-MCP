{
  "mcpb_version": "0.3",
  "name": "quickbooks-accounting-mcp",
  "display_name": "QuickBooks Accounting for Claude",
  "version": "2.0.0",
  "description": "The most comprehensive QuickBooks Online MCP server — 91 tools for transactions, reports, tax prep, bookkeeping automation, and financial analysis.",
  "long_description": "Connect Claude to your QuickBooks Online account. Run P&L reports, reconcile transactions, file-prep for Schedule C, detect anomalies, manage vendors/customers, batch operations, and more. Your financial data stays on your machine — zero cloud routing.",
  "author": {
    "name": "Ryan Colkitt",
    "email": "ryan@vasperacapital.com",
    "url": "https://github.com/RCOLKITT"
  },
  "repository": "https://github.com/RCOLKITT/AccountingQB-MCP",
  "license": "MIT",
  "keywords": [
    "quickbooks",
    "accounting",
    "bookkeeping",
    "tax",
    "schedule-c",
    "finance",
    "mcp",
    "claude"
  ],
  "server": {
    "type": "uv",
    "entry_point": "src/server.py",
    "mcp_config": {
      "command": "uv",
      "args": ["run", "${__dirname}/src/server.py"]
    }
  },
  "compatibility": {
    "platforms": ["darwin", "win32", "linux"]
  },
  "user_config": {
    "QB_CLIENT_ID": {
      "type": "string",
      "title": "QuickBooks Client ID",
      "description": "Your Intuit Developer app Client ID (from developer.intuit.com)",
      "required": true
    },
    "QB_CLIENT_SECRET": {
      "type": "string",
      "title": "QuickBooks Client Secret",
      "description": "Your Intuit Developer app Client Secret",
      "sensitive": true,
      "required": true
    },
    "QB_REALM_ID": {
      "type": "string",
      "title": "QuickBooks Company ID (Realm ID)",
      "description": "Your QuickBooks company/realm ID (found in your QuickBooks URL)",
      "required": true
    },
    "QB_REFRESH_TOKEN": {
      "type": "string",
      "title": "QuickBooks Refresh Token",
      "description": "Initial OAuth refresh token (will auto-rotate after first use)",
      "sensitive": true,
      "required": true
    },
    "QB_LICENSE_KEY": {
      "type": "string",
      "title": "License Key",
      "description": "Your product license key (leave blank for free tier — 25 read-only tools)",
      "required": false
    },
    "QB_ENVIRONMENT": {
      "type": "string",
      "title": "QuickBooks Environment",
      "description": "Set to 'sandbox' for testing, 'production' for live data",
      "default": "production",
      "required": false
    }
  },
  "tools": [
    {"name": "qb_company_info", "description": "Get company details, address, EIN, fiscal year"},
    {"name": "qb_list_transactions", "description": "List purchases/expenses in a date range"},
    {"name": "qb_list_deposits", "description": "List deposits and income"},
    {"name": "qb_list_transfers", "description": "List account transfers"},
    {"name": "qb_list_journal_entries", "description": "List journal entries"},
    {"name": "qb_list_bills", "description": "List accounts payable bills"},
    {"name": "qb_list_bill_payments", "description": "List bill payments"},
    {"name": "qb_list_sales_receipts", "description": "List sales receipts"},
    {"name": "qb_list_payments", "description": "List customer payments"},
    {"name": "qb_list_invoices", "description": "List invoices with status filter"},
    {"name": "qb_search_transactions", "description": "Search all transaction types"},
    {"name": "qb_expense_summary", "description": "Expenses by category"},
    {"name": "qb_income_summary", "description": "Income by category"},
    {"name": "qb_profit_loss", "description": "P&L / Income Statement"},
    {"name": "qb_balance_sheet", "description": "Balance Sheet report"},
    {"name": "qb_cash_flow", "description": "Statement of Cash Flows"},
    {"name": "qb_general_ledger", "description": "General ledger by account"},
    {"name": "qb_trial_balance", "description": "Trial balance report"},
    {"name": "qb_ar_aging", "description": "Accounts receivable aging"},
    {"name": "qb_ap_aging", "description": "Accounts payable aging"},
    {"name": "qb_tax_summary", "description": "Tax-oriented Schedule C mapping"},
    {"name": "qb_list_accounts", "description": "Chart of accounts"},
    {"name": "qb_list_vendors", "description": "List vendors/suppliers"},
    {"name": "qb_list_customers", "description": "List customers"},
    {"name": "qb_list_items", "description": "List products and services"},
    {"name": "qb_create_expense", "description": "Create a new expense"},
    {"name": "qb_create_invoice", "description": "Create a customer invoice"},
    {"name": "qb_create_journal_entry", "description": "Create a journal entry"},
    {"name": "qb_create_deposit", "description": "Create a bank deposit"},
    {"name": "qb_create_transfer", "description": "Transfer between accounts"},
    {"name": "qb_create_vendor", "description": "Create a new vendor"},
    {"name": "qb_create_customer", "description": "Create a new customer"},
    {"name": "qb_create_bill", "description": "Create a bill (AP)"},
