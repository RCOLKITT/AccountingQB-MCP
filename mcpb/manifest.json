{
  "manifest_version": "0.3",
  "name": "accountingqb",
  "display_name": "AccountingQB \u2014 QuickBooks for Claude",
  "version": "3.3.0",
  "icon": "icon.png",
  "description": "104 AI tools connecting Claude to QuickBooks Online. Reports, reconciliation, tax prep (US Schedule C + Canada GST/HST, T2125), anomaly detection \u2014 all through natural conversation.",
  "long_description": "Connect Claude to your QuickBooks Online with one click. Run P&L reports, reconcile transactions, prep for taxes, detect anomalies, and more. Full US and Canada support: Schedule C, quarterly estimates and 1099s for the US; GST/HST returns, T2125, CCA schedules, T4A reporting and CRA instalments for Canada. Your data stays on your machine \u2014 zero cloud routing.\n\n**Getting Started:**\n1. Enter your license key (get one at accountingqb.com)\n2. Click 'Connect QuickBooks' when prompted\n3. Start asking Claude about your books!\n\n**Requirements:** Python 3.10 or newer on your machine (all Python package dependencies are bundled with the extension).",
  "author": {
    "name": "Vaspera Capital",
    "email": "support@vasperacapital.com",
    "url": "https://accountingqb.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RCOLKITT/AccountingQB-MCP"
  },
  "homepage": "https://accountingqb.com",
  "license": "Commercial",
  "privacy_policies": [
    "https://accountingqb.com/privacy"
  ],
  "keywords": [
    "quickbooks",
    "accounting",
    "bookkeeping",
    "tax",
    "schedule-c",
    "canada",
    "gst",
    "hst",
    "t2125",
    "finance",
    "mcp",
    "claude",
    "ai-accounting"
  ],
  "server": {
    "type": "python",
    "entry_point": "src/accountingqb/server.py",
    "mcp_config": {
      "command": "python3",
      "args": [
        "-m",
        "accountingqb.server"
      ],
      "env": {
        "PYTHONPATH": "${__dirname}/src${pathSeparator}${__dirname}/server/lib",
        "QB_LICENSE_KEY": "${user_config.QB_LICENSE_KEY}",
        "QB_CLIENT_ID": "${user_config.QB_CLIENT_ID}",
        "QB_CLIENT_SECRET": "${user_config.QB_CLIENT_SECRET}",
        "QB_REALM_ID": "${user_config.QB_REALM_ID}",
        "QB_REFRESH_TOKEN": "${user_config.QB_REFRESH_TOKEN}",
        "QB_ENVIRONMENT": "${user_config.QB_ENVIRONMENT}"
      },
      "platform_overrides": {
        "win32": {
          "command": "python"
        }
      }
    }
  },
  "compatibility": {
    "platforms": [
      "darwin",
      "win32",
      "linux"
    ],
    "runtimes": {
      "python": ">=3.10"
    }
  },
  "user_config": {
    "QB_LICENSE_KEY": {
      "type": "string",
      "title": "License Key",
      "description": "Your AccountingQB license key (starts with LK-). Get one at accountingqb.com",
      "required": true
    },
    "QB_CLIENT_ID": {
      "type": "string",
      "title": "QuickBooks Client ID (Optional)",
      "description": "Only needed for self-hosted mode. Leave blank to use AccountingQB hosted OAuth.",
      "required": false
    },
    "QB_CLIENT_SECRET": {
      "type": "string",
      "title": "QuickBooks Client Secret (Optional)",
      "description": "Only needed for self-hosted mode.",
      "sensitive": true,
      "required": false
    },
    "QB_REALM_ID": {
      "type": "string",
      "title": "QuickBooks Company ID (Optional)",
      "description": "Only needed for self-hosted mode. In hosted mode, use qb_list_companies to manage.",
      "required": false
    },
    "QB_REFRESH_TOKEN": {
      "type": "string",
      "title": "QuickBooks Refresh Token (Optional)",
      "description": "Only needed for self-hosted mode.",
      "sensitive": true,
      "required": false
    },
    "QB_ENVIRONMENT": {
      "type": "string",
      "title": "QuickBooks Environment",
      "description": "Set to 'sandbox' for testing, 'production' for live data",
      "default": "production",
      "required": false
    }
  },
