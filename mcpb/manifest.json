    {"name": "qb_1099_contractor_report", "description": "1099-NEC contractor reporting"},
    {"name": "qb_sales_tax_summary", "description": "Sales tax summary by jurisdiction"},
    {"name": "qb_fiscal_year_close_checklist", "description": "Year-end close checklist"},
    {"name": "qb_books_health_audit", "description": "Comprehensive books health audit"},
    {"name": "qb_month_end_close", "description": "Month-end close checklist"},
    {"name": "qb_upload_receipt", "description": "Attach receipt to transaction"},
    {"name": "qb_list_attachments", "description": "List document attachments"},
    {"name": "qb_list_recurring_transactions", "description": "List recurring transactions"},
    {"name": "qb_list_estimates", "description": "List estimates/quotes"},
    {"name": "qb_list_credit_memos", "description": "List customer credit memos"},
    {"name": "qb_list_vendor_credits", "description": "List vendor credits"},
    {"name": "qb_list_journal_entries_by_memo", "description": "Search JEs by memo text"},
    {"name": "qb_inactivate_account", "description": "Deactivate an account"},
    {"name": "qb_profit_loss_by_class", "description": "P&L by class/department"}
  ],
  "tools_generated": true
}
