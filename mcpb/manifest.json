    {"name": "qb_create_estimate", "description": "Create a quote/estimate"},
    {"name": "qb_create_credit_memo", "description": "Create customer credit memo"},
    {"name": "qb_create_vendor_credit", "description": "Create vendor credit"},
    {"name": "qb_update_transaction", "description": "Update an existing transaction"},
    {"name": "qb_void_transaction", "description": "Void a transaction"},
    {"name": "qb_delete_transaction", "description": "Delete a transaction"},
    {"name": "qb_delete_journal_entry", "description": "Delete a journal entry"},
    {"name": "qb_reclassify_transaction", "description": "Reclassify to different account"},
