# ============================================================
# QuickBooks Accounting MCP — Environment Variables
# Copy this to .env.local and fill in your values.
# ============================================================

# --- Supabase ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (create these in your Stripe dashboard)
STRIPE_PRICE_SOLOPRENEUR=price_...
STRIPE_PRICE_BUSINESS=price_...
STRIPE_PRICE_FIRM=price_...

# --- QuickBooks OAuth ---
QB_CLIENT_ID=AB...your-intuit-client-id
QB_CLIENT_SECRET=...your-intuit-client-secret
QB_REDIRECT_URI=https://your-domain.vercel.app/api/oauth/callback

# --- App ---
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
