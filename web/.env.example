# ============================================================
# QuickBooks Accounting MCP — Environment Variables
# Copy this to .env.local and fill in your values.
# ============================================================

# --- Supabase ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (create these in your Stripe dashboard)
STRIPE_PRICE_SOLOPRENEUR=price_...
STRIPE_PRICE_BUSINESS=price_...
STRIPE_PRICE_FIRM=price_...

# --- QuickBooks OAuth ---
QB_CLIENT_ID=AB...your-intuit-client-id
QB_CLIENT_SECRET=...your-intuit-client-secret
QB_REDIRECT_URI=https://your-domain.vercel.app/api/oauth/callback

# --- App ---
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
# Base URL used for server-side callbacks/redirects (usually same as APP_URL)
NEXT_PUBLIC_BASE_URL=https://your-domain.vercel.app
# Public site URL for marketing/canonical links (usually same as APP_URL)
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# --- Resend (transactional email) ---
RESEND_API_KEY=re_...your-resend-api-key

# --- Upstash Redis (rate limiting; omit to disable rate limiting) ---
UPSTASH_REDIS_REST_URL=https://YOUR_INSTANCE.upstash.io
UPSTASH_REDIS_REST_TOKEN=...your-upstash-rest-token

# --- Support Agent (Claude API) ---
ANTHROPIC_API_KEY=sk-ant-...your-anthropic-api-key
SUPPORT_MODEL=claude-sonnet-4-20250514
SUPPORT_EMAIL=support@vasperacapital.com

# --- Admin Dashboard ---
ADMIN_PASSWORD=your-secure-admin-password

# --- Cron Jobs (Vercel) ---
CRON_SECRET=your-cron-secret-for-verification

# --- Clerk Authentication ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Svix signing secret for the Clerk webhook (/api/clerk/webhook)
CLERK_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
