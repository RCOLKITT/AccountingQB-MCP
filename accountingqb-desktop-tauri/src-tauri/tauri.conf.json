{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AccountingQB",
  "version": "0.1.0",
  "identifier": "com.vaspera.accountingqb",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "externalBin": ["binaries/accountingqb-server"],
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true
    },
    "windows": {
      "signCommand": "trusted-signing-cli -e https://eus.codesigning.azure.net -a AccountingQB -c AccountingQBPublic %1"
    }
  }
}
