{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AccountingQB",
  "version": "0.2.0",
  "identifier": "com.vaspera.accountingqb",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/RCOLKITT/AccountingQB-MCP/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE2MjFBRTgwNDJEMUVDMzIKUldReTdORkNnSzRocG5aYnYzQXIzTVI0L3RNdFloNGRIbkhZYVNWSEoxb29pTzd5cU9KbkloU1cK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["dmg", "nsis"],
    "externalBin": ["binaries/accountingqb-server"],
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true
    },
    "windows": {
      "signCommand": "trusted-signing-cli -e %AZURE_SIGNING_ENDPOINT% -a %AZURE_SIGNING_ACCOUNT% -c %AZURE_CERT_PROFILE% %1"
    }
  }
}
